      lib
  default-extensions:
      DeriveFunctor
      ImportQualifiedPost
      StrictData
  ghc-options: -Wall -Wredundant-constraints -Wmissing-export-lists -threaded
  build-depends:
      base >=4.7 && <5
    , bytestring
    , containers
    , directory
    , file-io >=0.1.6
    , filepath
    , os-string
    , pretty
    , prettyprinter
    , template-haskell
    , text
  default-language: GHC2024
