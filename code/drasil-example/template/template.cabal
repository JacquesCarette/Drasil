name:           template
version:        0.1.24.0
synopsis:       A framework for code and document generation for scientific software - Example SubPackage
description:    Please see the README on GitHub at <https://github.com/JacquesCarette/Drasil#readme>
homepage:       https://jacquescarette.github.io/Drasil/
bug-reports:    https://github.com/JacquesCarette/Drasil/issues
author:         Dan Szymczak, Steven Palmer, Jacques Carette, Spencer Smith
maintainer:     Jacques Carette
build-type:     Simple

source-repository head
  type: git
  location: https://github.com/JacquesCarette/Drasil

library
  exposed-modules:
      Drasil.Template.Body
  hs-source-dirs:
      lib
  default-extensions:
      StrictData
  ghc-options: -Wall -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , directory
    , drasil-data
    , drasil-database
    , drasil-gen
    , drasil-lang
    , drasil-srs
    , drasil-theory
    , lens
  default-language: GHC2024

executable template
  main-is: Main.hs
  hs-source-dirs:
      app
  default-extensions:
      StrictData
  ghc-options: -Wall -Wredundant-constraints -threaded -O2 -main-is Main
  build-depends:
      base >=4.7 && <5
    , directory
    , drasil-gen
    , lens
    , template
  default-language: GHC2024
