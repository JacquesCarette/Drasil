name:           projectile
version:        0.1.24.0
synopsis:       A framework for code and document generation for scientific software - Example SubPackage
description:    Please see the README on GitHub at <https://github.com/JacquesCarette/Drasil#readme>
homepage:       https://jacquescarette.github.io/Drasil/
bug-reports:    https://github.com/JacquesCarette/Drasil/issues
author:         Dan Szymczak, Steven Palmer, Jacques Carette, Spencer Smith
maintainer:     Jacques Carette
build-type:     Simple

source-repository head
  type: git
  location: https://github.com/JacquesCarette/Drasil

library
  exposed-modules:
      Drasil.Projectile.Assumptions
      Drasil.Projectile.Body
      Drasil.Projectile.Changes
      Drasil.Projectile.Choices
      Drasil.Projectile.Concepts
      Drasil.Projectile.DataDefs
      Drasil.Projectile.Derivations
      Drasil.Projectile.Expressions
      Drasil.Projectile.GenDefs
      Drasil.Projectile.Goals
      Drasil.Projectile.IMods
      Drasil.Projectile.LabelledContent
      Drasil.Projectile.MetaConcepts
      Drasil.Projectile.References
      Drasil.Projectile.Requirements
      Drasil.Projectile.Unitals
  hs-source-dirs:
      lib
  default-extensions:
      StrictData
  ghc-options: -Wall -Wredundant-constraints -Wmissing-export-lists
  build-depends:
      base >=4.7 && <5
    , directory
    , drasil-code
    , drasil-data
    , drasil-database
    , drasil-gen
    , drasil-gool
    , drasil-lang
    , drasil-srs
    , drasil-theory
    , drasil-utils
    , lens
  default-language: GHC2024

executable projectile
  main-is: Main.hs
  hs-source-dirs:
      app
  default-extensions:
      StrictData
  ghc-options: -Wall -Wredundant-constraints -Wmissing-export-lists -threaded -O2 -main-is Main
  build-depends:
      base >=4.7 && <5
    , directory
    , drasil-gen
    , lens
    , projectile
  default-language: GHC2024
