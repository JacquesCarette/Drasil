      Drasil.SWHS.Requirements
      Drasil.SWHS.TMods
      Drasil.SWHS.Unitals
  hs-source-dirs:
      lib
  default-extensions:
      StrictData
  ghc-options: -Wall -Wredundant-constraints -Wmissing-export-lists
  build-depends:
      base >=4.7 && <5
    , directory
    , drasil-data
    , drasil-database
    , drasil-gen
    , drasil-lang
    , drasil-srs
    , drasil-theory
    , drasil-utils
    , lens
  default-language: GHC2024

executable swhs
  main-is: Main.hs
