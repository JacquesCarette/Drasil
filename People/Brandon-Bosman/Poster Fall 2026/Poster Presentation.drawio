        </mxCell>
        <mxCell id="p-YKAdcl-ozBapOeaQL1-10" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;fontFamily=Poppins;fillColor=none;strokeColor=none;" value="&lt;font style=&quot;font-size: 35px;&quot;&gt;Common terms like &quot;package&quot;, &quot;module&quot;, and &quot;namespace&quot; mean drastically different things across languages; we avoid their use entirely in GOOL and use indexed levels of abstraction instead.&lt;/font&gt;" vertex="1">
          <mxGeometry height="337.5" width="714.5" x="1148" y="896" as="geometry" />
        </mxCell>
