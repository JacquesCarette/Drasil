      StrictData
  ghc-options: -Wall -Wredundant-constraints -Wmissing-export-lists
  build-depends:
      base >=4.7 && <5
    , bss
    , containers
    , dblpend
    , directory
    , drasil-code
    , drasil-data
    , drasil-database
    , drasil-file-handling
    , drasil-gen
    , drasil-gool
    , drasil-lang
    , drasil-printers
    , drasil-srs
    , drasil-system
    , gamephysics
    , glassbr
    , hghc
    , lens
    , pdcontroller
    , pretty
    , projectile
    , sglpend
    , split
    , ssp
    , swhs
    , swhsnopcm
    , template
  default-language: GHC2024

executable website
