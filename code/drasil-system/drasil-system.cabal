name:           drasil-system
version:        0.1.1.0
synopsis:       A framework for code and document generation for scientific software - System SubPackage
description:    Please see the README on GitHub at <https://github.com/JacquesCarette/Drasil#readme>
homepage:       https://jacquescarette.github.io/Drasil/
bug-reports:    https://github.com/JacquesCarette/Drasil/issues
author:         Dan Szymczak, Steven Palmer, Jacques Carette, Spencer Smith
maintainer:     Jacques Carette
build-type:     Simple

source-repository head
  type: git
  location: https://github.com/JacquesCarette/Drasil

library
  exposed-modules:
      Drasil.System
  other-modules:
      Drasil.System.Core
      Drasil.System.Transformations
  hs-source-dirs:
      lib
  default-extensions:
      StrictData
      TemplateHaskell
  ghc-options: -Wall -Wredundant-constraints -Wmissing-export-lists
  build-depends:
      base >=4.7 && <5
    , drasil-database
    , drasil-file-handling
    , drasil-lang
    , lens
  default-language: GHC2024
